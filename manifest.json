{
  "manifest_version": 3,
  "name": "Udemy TTS Pro",
  "version": "4.0",
  "description": "Udemy altyazılarını gelişmiş ayarlar, akıllı hız kontrolü ve video senkronizasyonu ile seslendirir.",
  "permissions": ["activeTab", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.udemy.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
